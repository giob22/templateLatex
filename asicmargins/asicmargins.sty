  ring.code       = {\directlua{asicmargins.set("ring","#1")}},
  blocks.code     = {\directlua{asicmargins.set("blocks","#1")}},
  macros.code     = {\directlua{asicmargins.set("macros","#1")}},
  pads.code       = {\directlua{asicmargins.set("pads","#1")}},
  dummy.code      = {\directlua{asicmargins.set("dummy","#1")}},
  metalthree.code = {\directlua{asicmargins.set("m3","#1")}},
}

\MarginCoreFinish{asicmargins}

